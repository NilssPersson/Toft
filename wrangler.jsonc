// Cloudflare Workers config: serves the static Astro build in ./dist as assets.
// Unknown paths get dist/404.html with a 404 status.
// The Worker name in the Cloudflare dashboard must match "name" below.
{
  "name": "toft",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
