// Cloudflare Workers config: serves the Vite build in ./dist as static assets.
// The Worker name in the Cloudflare dashboard must match "name" below.
{
  "name": "toft",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
