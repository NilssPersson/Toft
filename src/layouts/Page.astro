---
// Marketing-page layout: header, footer and site styles. Ships no JS.
import Base from './Base.astro';
import '../site/site.css';

type Props = Parameters<typeof Base>[0];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<Base {...Astro.props}>
  <header class="site-header">
    <a class="brand" href="/">Toft</a>
    <nav>
      {
        links.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="button small" href="/play">Play</a>
    </nav>
  </header>
  <main class="site-main">
    <slot />
  </main>
  <footer class="site-footer">© {new Date().getFullYear()} Toft</footer>
</Base>
