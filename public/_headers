# Cloudflare response headers for the static assets.
# The service worker and manifest must be revalidated on every load so updates are picked up.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Astro's build output is content-hashed, so it never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
